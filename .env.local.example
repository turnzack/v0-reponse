# Variables d'environnement Vercel - Kirov5 Sovereign Forge
# ⚠️  NE JAMAIS COMMITTER CE FICHIER — Ajouté dans .gitignore
# Ces variables doivent être configurées dans le Dashboard Vercel
# Settings > Environment Variables > marquées comme "Sensitive"

# ─── Neon PostgreSQL (Server-Side Only — jamais dans le bundle frontend) ───
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/kirov5db?sslmode=require

# ─── Chiffrement des clés API Providers (AES-GCM Master Key) ──────────────
DEEPSEEK_ENCRYPTION_KEY=REMPLACER_PAR_32_OCTETS_HEX_ALEATOIRES

# ─── Cloudflare Worker (Server-to-Server HMAC uniquement) ─────────────────
CLOUDFLARE_WORKER_URL=https://kirov-worker.votre-domaine.workers.dev
CLOUDFLARE_WORKER_AUTH_SECRET=REMPLACER_PAR_SECRET_HMAC_FORT

# ─── Session (clé de signature des cookies) ───────────────────────────────
SESSION_SECRET=REMPLACER_PAR_64_CARACTERES_ALEATOIRES
